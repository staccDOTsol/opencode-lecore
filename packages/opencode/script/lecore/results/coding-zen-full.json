      "finalSource": "export function delay(attempt: number, baseMs: number, maxMs: number, jitter = 1) {\n  if (attempt < 1 || !Number.isInteger(attempt)) throw new Error(\"attempt must be positive integer\")\n  if (baseMs < 0 || maxMs < 0 || jitter < 0) throw new Error(\"negative option\")\n  return Math.min(maxMs, Math.round(baseMs * 2 ** (attempt - 1) * jitter))\n}\n",
